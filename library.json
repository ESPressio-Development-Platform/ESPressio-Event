{
    "name": "ESPressio-Event",
    "description": "Event-Pattern library for ESP32-family microcontrollers",
    "keywords": "event,events,event-driven,event pattern,pattern,design pattern,async,callback,watcher,notifier,observable,bridge,espressio",
    "authors": {
        "name": "Simon J. Stuart",
        "maintainer": true,
        "url": "https://espressio.org"
    },
    "build": {
        "flags": ["-std=gnu++17","-DESPRESSIO_EVENT"]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Event.git"
    },
    "version": "6.0.3",
    "license": "Apache-2.0",
    "frameworks": "arduino",
    "platforms": "espressif32",
    "dependencies": [
        {
            "name": "ESPressio-Threads",
            "version": ">=3.1.7 <4.0.0",
            "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Threads.git",
            "platforms": "espressif32"
        },
        {
            "name": "ESPressio-Observable",
            "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Observable.git#feature/16-rtti-free-observer-registry",
            "platforms": "*"
        },
        {
            "owner": "espressio-development-platform",
            "name": "ESPressio-Timing",
            "version": ">=2.2.8 <3.0.0"
        }
    ]
}
