{
    "name": "ESPressio-Event",
    "description": "Fixed-capacity Local, Serializable and Transmissible Event occurrences with frozen typed dispatch",
    "keywords": "event,occurrence,bounded,dispatch,espressio",
    "authors": {
        "name": "Simon J. Stuart",
        "maintainer": true,
        "url": "https://espressio.org"
    },
    "build": {
        "flags": [
            "-std=gnu++17",
            "-DESPRESSIO_EVENT"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Event.git"
    },
    "version": "6.0.3",
    "license": "Apache-2.0",
    "frameworks": "arduino",
    "platforms": "espressif32",
    "dependencies": [
        {
            "name": "ESPressio-System",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-System.git#primitives_redesign",
            "platforms": "*"
        },
        {
            "name": "ESPressio-Primitive",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Primitive.git#primitives_redesign",
            "platforms": "*"
        },
        {
            "name": "ESPressio-Task",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Task.git#primitives_redesign",
            "platforms": "*"
        },
        {
            "name": "ESPressio-Threads",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Threads.git#primitives_redesign",
            "platforms": "*"
        },
        {
            "name": "ESPressio-Timing",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Timing.git#primitives_redesign",
            "platforms": "*"
        },
        {
            "name": "ESPressio-Serializable",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Serializable.git#primitives_redesign",
            "platforms": "*"
        }
    ]
}
