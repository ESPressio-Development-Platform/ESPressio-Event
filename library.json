            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Threads.git#structural_realignment",
            "platforms": "espressif32"
        },
        {
            "name": "ESPressio-Observable",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Observable.git#structural_realignment",
